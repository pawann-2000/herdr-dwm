{
  "global": {
    "cmd-k k": "mod.open:cheatsheet",
    "cmd-k cmd-k": "mod.open:cheatsheet",
    "cmd-k b": {
      "command": "tab.new",
      "args": {
        "mod": "browser",
        "name": "web"
      }
    },
    "cmd-k p": "sessions.port",
    "cmd-k g": "mod.open:solitaire",
    "cmd-k t": "mod.open:glass"
  },
  "layout:dwm": {
    "cmd-p": "mod.open:dwm",
    "cmd-shift-enter": "dwm.spawn",
    "cmd-b": "dwm.togglebar",
    "cmd-j": "dwm.focusnext",
    "cmd-shift-j": "dwm.focusprev",
    "cmd-enter": "dwm.zoom",
    "cmd-[": "dwm.lastview",
    "cmd-shift-c": "pane.close",
    "cmd-shift-t": "dwm.tile",
    "cmd-shift-m": "dwm.monocle",
    "cmd-shift-space": "pane.zoom",
    "cmd-shift-,": "space.prev",
    "cmd-shift-.": "space.next",
    "cmd-1": "tab.select:1",
    "cmd-2": "tab.select:2",
    "cmd-3": "tab.select:3",
    "cmd-4": "tab.select:4",
    "cmd-5": "tab.select:5",
    "cmd-6": "tab.select:6",
    "cmd-7": "tab.select:7",
    "cmd-8": "tab.select:8",
    "cmd-9": "tab.select:9",
    "cmd-e": "neotree.toggle",
    "cmd-s": "sessions.toggle",
    "ctrl-cmd-left": "pane.go:left",
    "ctrl-cmd-right": "pane.go:right",
    "ctrl-cmd-up": "pane.go:up",
    "ctrl-cmd-down": "pane.go:down"
  }
}
