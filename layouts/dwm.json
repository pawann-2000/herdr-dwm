{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [6, 2],
  "theme": "dwm",
  "ui_font": "JetBrains Mono",
  "terminal_padding": [2, 2],
  "background": "background",
  "resizable": false,
  "preview": "layouts/dwm.svg",
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": { "px": 18 },
      "window_drag": true,
      "content": { "mod": "dwm", "props": { "role": "bar" } }
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "tree",
          "type": "block",
          "size": { "px": 240 },
          "max": 600,
          "content": { "mod": "neotree", "props": { "block": "tree" } }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 0,
              "radius": 0,
              "background": "background",
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" },
              "lone": true
            }
          }
        },
        {
          "id": "sessions",
          "type": "block",
          "size": { "px": 260 },
          "max": 600,
          "content": { "mod": "sessions", "props": { "block": "sessions" } }
        }
      ]
    }
  ]
}
